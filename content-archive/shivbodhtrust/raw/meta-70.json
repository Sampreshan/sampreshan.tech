ntent=\\\"History and authentic Guru Parampara of Purvamnaya Govardhan Matha, Puri, Odisha. Established by Adi Shankaracharya.\\\">\\n    <meta name=\\\"keywords\\\" content=\\\"Govardhan Math Puri, Purvamnaya Peeth, Adi Shankaracharya, Hastamalakacharya, Swami Nischalananda Saraswati\\\">\\n    \\n    <link href=\\\"https:\\\/\\\/cdnjs.cloudflare.com\\\/ajax\\\/libs\\\/font-awesome\\\/6.4.0\\\/css\\\/all.min.css\\\" rel=\\\"stylesheet\\\">\\n    <link href=\\\"https:\\\/\\\/fonts.googleapis.com\\\/css2?family=Cinzel:wght@500;700;800&family=Lato:wght@300;400;700&family=Alegreya:wght@400;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n    \\n    <!-- Link to External CSS -->\\n    <link rel=\\\"stylesheet\\\" href=\\\"puri-peeth-style.css\\\">\\n<\\\/head>\\n<body data-lang=\\\"hi\\\">\\n\\n    <div class=\\\"bg-pattern\\\"><\\\/div>\\n\\n    <!-- Language Switcher -->\\n    <div class=\\\"lang-switcher\\\">\\n        <button class=\\\"lang-btn\\\" onclick=\\\"changeLanguage('en')\\\" id=\\\"btn-en\\\">English<\\\/button>\\n        <button class=\\\"lang-btn active\\\" onclick=\\\"changeLanguage('hi')\\\" id=\\\"btn-hi\\\">\\u0939\\u093f\\u0928\\u094d\\u0926\\u0940<\\\/button>\\n    <\\\/div>\\n\\n    <!-- Hero Section -->\\n    <section class=\\\"profile-hero\\\">\\n        <div class=\\\"hero-text-col\\\">\\n            <span class=\\\"peeth-tag\\\">\\n                <span class=\\\"en\\\">P\\u016brv\\u0101mn\\u0101ya \\u015ar\\u012b Govardhana P\\u012b\\u1e6dham<\\\/span>\\n                <span class=\\\"hi\\\">\\u092a\\u0942\\u0930\\u094d\\u0935\\u093e\\u092e\\u094d\\u0928\\u093e\\u092f \\u0936\\u094d\\u0930\\u0940 \\u0917\\u094b\\u0935\\u0930\\u094d\\u0927\\u0928 \\u092e\\u0920 (\\u092a\\u0941\\u0930\\u0940)<\\\/span>\\n            <\\\/span>\\n            <h1 class=\\\"main-title\\\">\\n                <span class=\\\"en\\\">Govardhan Matha<\\\/span>\\n                <span class=\\\"hi\\\">\\u0917\\u094b\\u0935\\u0930\\u094d\\u0927\\u0928 \\u092e\\u0920 (\\u092a\\u0941\\u0930\\u0940)<\\\/span>\\n            <\\\/h1>\\n            <p class=\\\"sub-title\\\">\\n                <span class=\\\"en\\\">Puri, Odisha | Established by Jagadguru Adi Shankaracharya<\\\/span>\\n                <span class=\\\"hi\\\">\\u092a\\u0941\\u0930\\u0940, \\u0913\\u0921\\u093f\\u0936\\u093e | \\u091c\\u0917\\u0926\\u094d\\u0917\\u0941\\u0930\\u0941 \\u0906\\u0926\\u093f \\u0936\\u0902\\u0915\\u0930\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f \\u0926\\u094d\\u0935\\u093e\\u0930\\u093e \\u0938\\u094d\\u0925\\u093e\\u092a\\u093f\\u0924<\\\/span>\\n            <\\\/p>\\n            \\n            <div class=\\\"info-grid\\\">\\n                <div class=\\\"info-item\\\">\\n                    <span class=\\\"info-label\\\"><span class=\\\"en\\\">Veda<\\\/span><span class=\\\"hi\\\">\\u0935\\u0947\\u0926<\\\/span><\\\/span>\\n                    <div class=\\\"info-val\\\"><span class=\\\"en\\\">Rig Veda<\\\/span><span class=\\\"hi\\\">\\u090b\\u0917\\u094d\\u0935\\u0947\\u0926<\\\/span><\\\/div>\\n                <\\\/div>\\n                <div class=\\\"info-item\\\">\\n                    <span class=\\\"info-label\\\"><span class=\\\"en\\\">Mahavakya<\\\/span><span class=\\\"hi\\\">\\u092e\\u0939\\u093e\\u0935\\u093e\\u0915\\u094d\\u092f<\\\/span><\\\/span>\\n                    <div class=\\\"info-val\\\"><span class=\\\"en\\\">Prajn\\u0101nam Brahma<\\\/span><span class=\\\"hi\\\">\\u092a\\u094d\\u0930\\u091c\\u094d\\u091e\\u093e\\u0928\\u0902 \\u092c\\u094d\\u0930\\u0939\\u094d\\u092e<\\\/span><\\\/div>\\n                <\\\/div>\\n                <div class=\\\"info-item\\\">\\n                    <span class=\\\"info-label\\\"><span class=\\\"en\\\">First Acharya<\\\/span><span class=\\\"hi\\\">\\u092a\\u094d\\u0930\\u0925\\u092e \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f<\\\/span><\\\/span>\\n                    <div class=\\\"info-val\\\"><span class=\\\"en\\\">Sri Hastamalakacharya<\\\/span><span class=\\\"hi\\\">\\u0936\\u094d\\u0930\\u0940 \\u0939\\u0938\\u094d\\u0924\\u093e\\u092e\\u0932\\u0915\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f<\\\/span><\\\/div>\\n                <\\\/div>\\n            <\\\/div>\\n        <\\\/div>\\n        \\n        <div class=\\\"hero-image-col\\\">\\n            <div class=\\\"portrait-frame\\\">\\n                <!-- PURI PEETH IMAGE -->\\n                <img src=\\\"http:\\\/\\\/shivbodhtrust.org\\\/wp-content\\\/uploads\\\/2026\\\/03\\\/puri.png\\\" alt=\\\"Govardhan Math Puri\\\" class=\\\"main-img\\\">\\n                <div class=\\\"img-caption\\\">\\n                    <span class=\\\"en\\\">The Sacred Seat of Lord Jagannath<\\\/span>\\n                    <span class=\\\"hi\\\">\\u092d\\u0917\\u0935\\u093e\\u0928 \\u091c\\u0917\\u0928\\u094d\\u0928\\u093e\\u0925 \\u0915\\u093e \\u092a\\u0935\\u093f\\u0924\\u094d\\u0930 \\u0927\\u093e\\u092e<\\\/span>\\n                <\\\/div>\\n            <\\\/div>\\n        <\\\/div>\\n    <\\\/section>\\n\\n    <!-- Guru Parampara Section -->\\n    <article class=\\\"content-container\\\">\\n        \\n        <div class=\\\"parampara-section\\\" style=\\\"margin-top: 50px;\\\">\\n            <h2 class=\\\"chapter-heading\\\" style=\\\"justify-content: center; text-align: center;\\\">\\n                <span class=\\\"en\\\">The Sacred Guru Parampara<\\\/span>\\n                <span class=\\\"hi\\\">\\u092a\\u0935\\u093f\\u0924\\u094d\\u0930 \\u0917\\u0941\\u0930\\u0941 \\u092a\\u0930\\u092e\\u094d\\u092a\\u0930\\u093e \\u0915\\u0940 \\u0938\\u0942\\u091a\\u0940<\\\/span>\\n            <\\\/h2>\\n            <p style=\\\"text-align:center; color:var(--text-gray); margin-bottom: 30px;\\\">\\n                <span class=\\\"en\\\">The illustrious spiritual lineage of Govardhan Math, Puri<\\\/span>\\n                <span class=\\\"hi\\\">\\u0906\\u0926\\u093f \\u0936\\u0902\\u0915\\u0930\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f \\u0938\\u0947 \\u0932\\u0947\\u0915\\u0930 \\u0935\\u0930\\u094d\\u0924\\u092e\\u093e\\u0928 \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f \\u0924\\u0915 \\u0917\\u094b\\u0935\\u0930\\u094d\\u0927\\u0928 \\u092a\\u0940\\u0920 \\u0915\\u0940 \\u0917\\u094c\\u0930\\u0935\\u0936\\u093e\\u0932\\u0940 \\u0906\\u0927\\u094d\\u092f\\u093e\\u0924\\u094d\\u092e\\u093f\\u0915 \\u0935\\u0902\\u0936\\u093e\\u0935\\u0932\\u0940<\\\/span>\\n            <\\\/p>\\n\\n            <div class=\\\"rich-box\\\" style=\\\"padding: 30px; background: #fff; border: 1px solid var(--gold-accent); border-radius: 10px;\\\">\\n                \\n                <!-- PART 1 -->\\n                <h3 class=\\\"part-heading\\\"><span class=\\\"en\\\">Part 1: Ancient Acharyas<\\\/span><span class=\\\"hi\\\">\\u092d\\u093e\\u0917 1: \\u092a\\u094d\\u0930\\u093e\\u091a\\u0940\\u0928 \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f (\\u0906\\u0926\\u093f \\u0936\\u0902\\u0915\\u0930\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f \\u0938\\u0947 15\\u0935\\u0940\\u0902 \\u0936\\u0924\\u093e\\u092c\\u094d\\u0926\\u0940 \\u0924\\u0915)<\\\/span><\\\/h3>\\n\\n                <div class=\\\"guru-row\\\">\\n                    <div class=\\\"guru-icon\\\">1<\\\/div><div class=\\\"guru-details\\\">\\n                        <span class=\\\"guru-name-title\\\"><span class=\\\"en\\\">Adi Shankaracharya<\\\/span><span class=\\\"hi\\\">\\u0906\\u0926\\u093f \\u0936\\u0902\\u0915\\u0930\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f<\\\/span><\\\/span>\\n                        <span class=\\\"guru-period\\\"><span class=\\\"en\\\">8th Century CE (Approx)<\\\/span><span class=\\\"hi\\\">8\\u0935\\u0940\\u0902 \\u0936\\u0924\\u093e\\u092c\\u094d\\u0926\\u0940 \\u0908. (\\u0932\\u0917\\u092d\\u0917)<\\\/span><\\\/span>\\n                        <p class=\\\"guru-desc\\\"><span class=\\\"en\\\">Founder of the four Peethams. Established this seat here and laid the foundation of the 'Mukti Mandap'.<\\\/span><span class=\\\"hi\\\">\\u091a\\u093e\\u0930\\u094b\\u0902 \\u092a\\u0940\\u0920\\u094b\\u0902 \\u0915\\u0947 \\u0938\\u0902\\u0938\\u094d\\u0925\\u093e\\u092a\\u0915\\u0964 \\u0907\\u0928\\u094d\\u0939\\u094b\\u0902\\u0928\\u0947 \\u092f\\u0939\\u093e\\u0901 \\u092a\\u0930 \\u092a\\u0940\\u0920 \\u0915\\u0940 \\u0938\\u094d\\u0925\\u093e\\u092a\\u0928\\u093e \\u0915\\u0940 \\u0914\\u0930 '\\u092e\\u0941\\u0915\\u094d\\u0924\\u093f \\u092e\\u0902\\u0921\\u092a' \\u092e\\u0947\\u0902 \\u0935\\u093f\\u0926\\u094d\\u0935\\u0924 \\u092a\\u0930\\u093f\\u0937\\u0926 \\u0915\\u0940 \\u0928\\u0940\\u0902\\u0935 \\u0930\\u0916\\u0940\\u0964<\\\/span><\\\/p>\\n                    <\\\/div>\\n                <\\\/div>\\n                \\n                <div class=\\\"guru-row\\\">\\n                    <div class=\\\"guru-icon\\\">2<\\\/div><div class=\\\"guru-details\\\">\\n                        <span class=\\\"guru-name-title\\\"><span class=\\\"en\\\">Sri Hastamalakacharya<\\\/span><span class=\\\"hi\\\">\\u0936\\u094d\\u0930\\u0940 \\u0939\\u0938\\u094d\\u0924\\u093e\\u092e\\u0932\\u0915\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f<\\\/span><\\\/span>\\n                        <span class=\\\"guru-period\\\"><span class=\\\"en\\\">8th Century CE<\\\/span><span class=\\\"hi\\\">8\\u0935\\u0940\\u0902 \\u0936\\u0924\\u093e\\u092c\\u094d\\u0926\\u0940 \\u0908.<\\\/span><\\\/span>\\n                        <p class=\\\"guru-desc\\\"><span class=\\\"en\\\">Chief disciple and First Peethadheeshwar. Gained supreme knowledge by the grace of his Guru.<\\\/span><span class=\\\"hi\\\">\\u0906\\u0926\\u093f \\u0936\\u0902\\u0915\\u0930\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f \\u0915\\u0947 \\u092a\\u094d\\u0930\\u092e\\u0941\\u0916 \\u0936\\u093f\\u0937\\u094d\\u092f \\u0914\\u0930 \\u0907\\u0938 \\u092a\\u0940\\u0920 \\u0915\\u0947 \\u092a\\u094d\\u0930\\u0925\\u092e \\u092a\\u0940\\u0920\\u093e\\u0927\\u0940\\u0936\\u094d\\u0935\\u0930\\u0964 \\u092f\\u0947 \\u091c\\u0928\\u094d\\u092e \\u0938\\u0947 \\u092e\\u0942\\u0915 \\u0925\\u0947, \\u0932\\u0947\\u0915\\u093f\\u0928 \\u0917\\u0941\\u0930\\u0941 \\u0915\\u0940 \\u0915\\u0943\\u092a\\u093e \\u0938\\u0947 \\u091c\\u094d\\u091e\\u093e\\u0928 \\u092a\\u094d\\u0930\\u093e\\u092a\\u094d\\u0924 \\u0915\\u093f\\u092f\\u093e\\u0964<\\\/span><\\\/p>\\n                    <\\\/div>\\n                <\\\/div>\\n\\n                <div class=\\\"guru-row\\\">\\n                    <div class=\\\"guru-icon\\\">3<\\\/div><div class=\\\"guru-details\\\">\\n                        <span class=\\\"guru-name-title\\\"><span class=\\\"en\\\">Sri Padmapadacharya<\\\/span><span class=\\\"hi\\\">\\u0936\\u094d\\u0930\\u0940 \\u092a\\u0926\\u094d\\u092e\\u092a\\u093e\\u0926\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f<\\\/span><\\\/span>\\n                        <span class=\\\"guru-period\\\"><span class=\\\"en\\\">8th Century CE<\\\/span><span class=\\\"hi\\\">8\\u0935\\u0940\\u0902 \\u0936\\u0924\\u093e\\u092c\\u094d\\u0926\\u0940 \\u0908. \\u0915\\u0947 \\u092c\\u093e\\u0926<\\\/span><\\\/span>\\n                        <p class=\\\"guru-desc\\\"><span class=\\\"en\\\">Associated with the Puri Peeth tradition for a period of time.<\\\/span><span class=\\\"hi\\\">\\u092a\\u0930\\u0902\\u092a\\u0930\\u093e \\u092e\\u0947\\u0902 \\u0935\\u0947 \\u0915\\u0941\\u091b \\u0938\\u092e\\u092f \\u092a\\u0941\\u0930\\u0940 \\u092a\\u0940\\u0920 \\u0938\\u0947 \\u092d\\u0940 \\u091c\\u0941\\u0921\\u093c\\u0947 \\u0930\\u0939\\u0947\\u0964 \\u0915\\u0941\\u091b \\u0938\\u0942\\u091a\\u093f\\u092f\\u094b\\u0902 \\u092e\\u0947\\u0902 \\u0907\\u0928\\u0915\\u093e \\u0928\\u093e\\u092e \\u0926\\u0942\\u0938\\u0930\\u0947 \\u092f\\u093e \\u0924\\u0940\\u0938\\u0930\\u0947 \\u0938\\u094d\\u0925\\u093e\\u0928 \\u092a\\u0930 \\u092e\\u093f\\u0932\\u0924\\u093e \\u0939\\u0948\\u0964<\\\/span><\\\/p>\\n                    <\\\/div>\\n                <\\\/div>\\n\\n                <div style=\\\"text-align:center; padding:15px; color:#555; border-bottom: 1px dashed rgba(212, 175, 55, 0.3);\\\">\\n                    <i class=\\\"fas fa-history\\\" style=\\\"color:var(--gold-accent); font-size:1.2em; margin-bottom:10px;\\\"><\\\/i>\\n                    <p style=\\\"margin:0; font-style:italic;\\\" class=\\\"en\\\">Between the 9th and 14th centuries, a lineage of about 16-17 eminent Acharyas guided the Peetham, preserving Sanatana Dharma during historical transitions.<\\\/p>\\n                    <p style=\\\"margin:0; font-style:italic;\\\" class=\\\"hi\\\">(9\\u0935\\u0940\\u0902 - 14\\u0935\\u0940\\u0902 \\u0936\\u0924\\u093e\\u092c\\u094d\\u0926\\u0940) \\u0907\\u0938 \\u0915\\u093e\\u0932 \\u092e\\u0947\\u0902 \\u0932\\u0917\\u092d\\u0917 16-17 \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f\\u094b\\u0902 \\u0928\\u0947 \\u0927\\u0930\\u094d\\u092e \\u0915\\u0940 \\u0930\\u0915\\u094d\\u0937\\u093e \\u0915\\u0940\\u0964 \\u0917\\u091c\\u092a\\u0924\\u093f \\u0935\\u0902\\u0936 \\u0915\\u0947 \\u0909\\u0926\\u092f \\u0938\\u0947 \\u092a\\u0939\\u0932\\u0947 \\u092f\\u0939 \\u0915\\u093e\\u0932 \\u0910\\u0924\\u093f\\u0939\\u093e\\u0938\\u093f\\u0915 \\u0930\\u0942\\u092a \\u0938\\u0947 \\u0905\\u0924\\u094d\\u092f\\u0902\\u0924 \\u0938\\u0902\\u0918\\u0930\\u094d\\u0937\\u092a\\u0942\\u0930\\u094d\\u0923 \\u0930\\u0939\\u093e\\u0964<\\\/p>\\n                <\\\/div>\\n\\n                <!-- PART 2 -->\\n                <h3 class=\\\"part-heading\\\"><span class=\\\"en\\\">Part 2: Medieval Acharyas<\\\/span><span class=\\\"hi\\\">\\u092d\\u093e\\u0917 2: \\u092e\\u0927\\u094d\\u092f\\u0915\\u093e\\u0932\\u0940\\u0928 \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f (\\u0917\\u091c\\u092a\\u0924\\u093f \\u0938\\u093e\\u092e\\u094d\\u0930\\u093e\\u091c\\u094d\\u092f \\u0915\\u093e\\u0932)<\\\/span><\\\/h3>\\n                \\n                <div class=\\\"guru-row\\\">\\n                    <div class=\\\"guru-icon\\\">20<\\\/div><div class=\\\"guru-details\\\">\\n                        <span class=\\\"guru-name-title\\\"><span class=\\\"en\\\">Swami Ramananda Tirtha<\\\/span><span class=\\\"hi\\\">\\u0938\\u094d\\u0935\\u093e\\u092e\\u0940 \\u0930\\u093e\\u092e\\u093e\\u0928\\u0902\\u0926 \\u0924\\u0940\\u0930\\u094d\\u0925<\\\/span><\\\/span>\\n                        <span class=\\\"guru-period\\\">1450 - 1480<\\\/span>\\n                        <p class=\\\"guru-desc\\\"><span class=\\\"en\\\">Contemporary of King Kapilendra Deva. Bestowed the title 'Sri Jagannath Das' upon the king.<\\\/span><span class=\\\"hi\\\">\\u0917\\u091c\\u092a\\u0924\\u093f \\u0930\\u093e\\u091c\\u093e \\u0915\\u092a\\u093f\\u0932\\u0947\\u0902\\u0926\\u094d\\u0930 \\u0926\\u0947\\u0935 \\u0915\\u0947 \\u0938\\u092e\\u0915\\u093e\\u0932\\u0940\\u0928\\u0964 \\u0907\\u0928\\u094d\\u0939\\u094b\\u0902\\u0928\\u0947 \\u0930\\u093e\\u091c\\u093e \\u0915\\u094b '\\u0936\\u094d\\u0930\\u0940 \\u091c\\u0917\\u0928\\u094d\\u0928\\u093e\\u0925 \\u0926\\u093e\\u0938' \\u0915\\u0940 \\u0909\\u092a\\u093e\\u0927\\u093f \\u0926\\u0940 \\u0925\\u0940\\u0964<\\\/span><\\\/p>\\n                    <\\\/div>\\n                <\\\/div>\\n                <div class=\\\"guru-row\\\">\\n                    <div class=\\\"guru-icon\\\">21<\\\/div><div class=\\\"guru-details\\\">\\n                        <span class=\\\"guru-name-title\\\"><span class=\\\"en\\\">Swami Krishnananda Tirtha<\\\/span><span class=\\\"hi\\\">\\u0938\\u094d\\u0935\\u093e\\u092e\\u0940 \\u0915\\u0943\\u0937\\u094d\\u0923\\u093e\\u0928\\u0902\\u0926 \\u0924\\u0940\\u0930\\u094d\\u0925<\\\/span><\\\/span>\\n                        <span class=\\\"guru-period\\\">1480 - 1510<\\\/span>\\n                        <p class=\\\"guru-desc\\\"><span class=\\\"en\\\">During the time of King Purushottama Deva.<\\\/span><span class=\\\"hi\\\">\\u0930\\u093e\\u091c\\u093e \\u092a\\u0941\\u0930\\u0941\\u0937\\u094b\\u0924\\u094d\\u0924\\u092e \\u0926\\u0947\\u0935 \\u0915\\u0947 \\u0938\\u092e\\u092f\\u0964 \\u0915\\u0902\\u0926\\u0930\\u092a\\u093e\\u0930\\u0915\\u093e \\u0924\\u093e\\u092e\\u094d\\u0930\\u092a\\u0924\\u094d\\u0930 \\u092e\\u0