{"ID":113,"post_author":"1","post_date":"2026-03-05 18:03:26","post_date_gmt":"2026-03-05 18:03:26","post_content":"<!DOCTYPE html>\n<html lang=\"hi\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>71st Aacharya - Kanchi Kamakoti Upa Peetham<\/title>\n    <!-- Link to the external stylesheet -->\n    <link rel=\"stylesheet\" href=\"style.css\">\n<\/head>\n<body>\n    <!-- Main Wrapper -->\n        <!-- Header Banner Section -->\n        <header>\n            <h2>\u0915\u093e\u0902\u091a\u0940 \u0915\u093e\u092e\u0915\u094b\u091f\u093f \u0909\u092a \u092a\u0940\u0920<\/h2>\n            <h1>\u092a\u0930\u092e \u092a\u0942\u091c\u094d\u092f 71\u0935\u0947\u0902 \u0906\u091a\u093e\u0930\u094d\u092f<\/h1>\n            <p>The Glorious Lineage of Kanchi Kamakoti Upa Peetham<\/p>\n        <\/header>\n        <!-- Main Content Area -->\n        <main>\n            <!-- Left Side: Image Profile -->\n            <section>\n                    <img src=\"https:\/\/shivbodhtrust.org\/wp-content\/uploads\/2026\/03\/kanchiaacharya.jpg\" alt=\"Sri Satya Chandrashekarendra Saraswathi Aacharya\">\n                    <h3>\u0936\u094d\u0930\u0940 \u0938\u0924\u094d\u092f \u091a\u0902\u0926\u094d\u0930\u0936\u0947\u0916\u0930\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0906\u091a\u093e\u0930\u094d\u092f<\/h3>\n                    (Sri Satya Chandrashekarendra Saraswathi)\n                    71\u0935\u0947\u0902 \u0906\u091a\u093e\u0930\u094d\u092f, \u0915\u093e\u0902\u091a\u0940 \u0909\u092a \u092a\u0940\u0920\n            <\/section>\n            <!-- Right Side: Biographical Information -->\n            <section>\n                <!-- Intro Block -->\n                    <h2>\u0926\u093f\u0935\u094d\u092f \u092a\u0930\u093f\u091a\u092f (Divine Introduction)<\/h2>\n                    <p>\n                        \u0915\u093e\u0902\u091a\u0940 \u0915\u093e\u092e\u0915\u094b\u091f\u093f \u0909\u092a \u092a\u0940\u0920 \u0915\u0947 71\u0935\u0947\u0902 \u0906\u091a\u093e\u0930\u094d\u092f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 <strong>\u0936\u094d\u0930\u0940 \u0938\u0924\u094d\u092f \u091a\u0902\u0926\u094d\u0930\u0936\u0947\u0916\u0930\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0906\u091a\u093e\u0930\u094d\u092f<\/strong> \u091c\u0940 \u0915\u093e \u092a\u091f\u094d\u091f\u093e\u092d\u093f\u0937\u0947\u0915 \u0905\u0924\u094d\u092f\u0902\u0924 \u0917\u094c\u0930\u0935\u092e\u092f\u0940 \u0935\u0948\u0926\u093f\u0915 \u092a\u0930\u0902\u092a\u0930\u093e \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u092a\u0928\u094d\u0928 \u0939\u0941\u0906 \u0939\u0948\u0964 \u0905\u092a\u0928\u0940 \u092f\u0941\u0935\u093e\u0935\u0938\u094d\u0925\u093e \u092e\u0947\u0902 \u0939\u0940 \u0938\u0902\u0928\u094d\u092f\u093e\u0938 \u0926\u0940\u0915\u094d\u0937\u093e \u0917\u094d\u0930\u0939\u0923 \u0915\u0930 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0935\u093f\u0936\u094d\u0935 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0935\u0948\u0930\u093e\u0917\u094d\u092f \u0915\u093e \u090f\u0915 \u092e\u0939\u093e\u0928 \u0906\u0926\u0930\u094d\u0936 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \n                    <\/p>\n                <!-- Dedication to Sanatan Dharma Block -->\n                    <h2>\u0938\u0928\u093e\u0924\u0928 \u0927\u0930\u094d\u092e \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0938\u092e\u0930\u094d\u092a\u0923 (Dedication to Dharma)<\/h2>\n                    <p>\n                        \u0906\u091a\u093e\u0930\u094d\u092f \u091c\u0940 \u0915\u093e \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u091c\u0940\u0935\u0928 \u0938\u0928\u093e\u0924\u0928 \u0927\u0930\u094d\u092e \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0939\u0948\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0938\u093e\u0902\u0938\u093e\u0930\u093f\u0915 \u092e\u094b\u0939-\u092e\u093e\u092f\u093e \u0915\u094b \u0924\u094d\u092f\u093e\u0917 \u0915\u0930, \u0927\u0930\u094d\u092e \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u091c\u0940\u0935\u0928 \u092a\u0942\u0930\u094d\u0923\u0924\u0903 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u090b\u0917\u094d\u0935\u0947\u0926 \u0915\u0947 \u092a\u094d\u0930\u0915\u093e\u0902\u0921 \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0939\u094b\u0924\u0947 \u0939\u0941\u090f \u092d\u0940, \u0909\u0928\u0915\u093e \u090f\u0915\u092e\u093e\u0924\u094d\u0930 \u0927\u094d\u092f\u0947\u092f \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0935\u0948\u0926\u093f\u0915 \u091c\u094d\u091e\u093e\u0928 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u0930\u0928\u093e, \u0917\u094b-\u0938\u0947\u0935\u093e \u0915\u0930\u0928\u093e \u0914\u0930 \u0938\u092e\u093e\u091c \u0915\u094b \u0927\u0930\u094d\u092e \u0915\u0947 \u092e\u093e\u0930\u094d\u0917 \u092a\u0930 \u092a\u094d\u0930\u0936\u0938\u094d\u0924 \u0915\u0930\u0928\u093e \u0939\u0948\u0964\n                    <\/p>\n                <!-- Reverence & Devotion Block (NEWLY ADDED SECTION) -->\n                    <h2>\u091c\u0928\u092e\u093e\u0928\u0938 \u092e\u0947\u0902 \u0905\u0917\u093e\u0927 \u0936\u094d\u0930\u0926\u094d\u0927\u093e (Reverence among Devotees)<\/h2>\n                    <p>\n                        \u0926\u0915\u094d\u0937\u093f\u0923 \u092d\u093e\u0930\u0924 \u0938\u0939\u093f\u0924 \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u092d\u093e\u0930\u0924\u0935\u0930\u094d\u0937 \u092e\u0947\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941\u0913\u0902 \u0915\u0947 \u092c\u0940\u091a \u0906\u091a\u093e\u0930\u094d\u092f \u091c\u0940 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0905\u0917\u093e\u0927 \u0936\u094d\u0930\u0926\u094d\u0927\u093e \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u0924\u092a\u094b\u092c\u0932, \u0917\u0939\u0928 \u0935\u0948\u0926\u093f\u0915 \u091c\u094d\u091e\u093e\u0928 \u0914\u0930 \u0927\u0930\u094d\u092e \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0905\u0938\u0940\u092e \u0938\u092e\u0930\u094d\u092a\u0923 \u0915\u0947 \u0915\u093e\u0930\u0923, \u092d\u0915\u094d\u0924\u0917\u0923 <strong>\u0907\u0928\u094d\u0939\u0947\u0902 \u0936\u0902\u0915\u0930\u093e\u091a\u093e\u0930\u094d\u092f \u0915\u0947 \u0938\u092e\u0924\u0941\u0932\u094d\u092f \u0939\u0940 \u090f\u0915 \u092e\u0939\u093e\u0928 \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0914\u0930 \u0924\u092a\u0938\u094d\u0935\u0940 \u092e\u093e\u0928\u0924\u0947 \u0939\u0948\u0902\u0964<\/strong> \u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u0940 \u0926\u0943\u0937\u094d\u091f\u093f \u092e\u0947\u0902 \u0907\u0928\u0915\u093e \u0938\u094d\u0925\u093e\u0928 \u0905\u0924\u094d\u092f\u0902\u0924 \u0909\u091a\u094d\u091a \u0939\u0948 \u0914\u0930 \u0935\u0947 \u092a\u0942\u0930\u094d\u0923 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u092d\u093e\u0935 \u0938\u0947 \u092f\u0939 \u092e\u093e\u0928\u0915\u0930 \u0939\u0940 \u0907\u0928\u0915\u0940 \u0935\u0902\u0926\u0928\u093e \u0914\u0930 \u092a\u0942\u091c\u093e-\u0905\u0930\u094d\u091a\u0928\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092f\u0947 \u092d\u0940 \u0938\u093e\u0915\u094d\u0937\u093e\u0924 \u0936\u0902\u0915\u0930\u093e\u091a\u093e\u0930\u094d\u092f \u0938\u094d\u0935\u0930\u0942\u092a \u0939\u0940 \u0939\u0948\u0902\u0964\n                    <\/p>\n                <!-- Anointment Block -->\n                    <h2>\u0938\u0902\u0928\u094d\u092f\u093e\u0938 \u0926\u0940\u0915\u094d\u0937\u093e \u0914\u0930 \u0905\u092d\u093f\u0937\u0947\u0915 (The Sacred Anointment)<\/h2>\n                    <p>\n                        \u0905\u0915\u094d\u0937\u092f \u0924\u0943\u0924\u0940\u092f\u093e \u0915\u0947 \u0905\u0924\u094d\u092f\u0902\u0924 \u092a\u093e\u0935\u0928 \u0905\u0935\u0938\u0930 \u092a\u0930, \u0909\u092a \u092a\u0940\u0920 \u0915\u0947 70\u0935\u0947\u0902 \u0906\u091a\u093e\u0930\u094d\u092f <strong>\u0936\u094d\u0930\u0940 \u0936\u0902\u0915\u0930 \u0935\u093f\u091c\u092f\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u091c\u0940<\/strong> \u0926\u094d\u0935\u093e\u0930\u093e \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u0902\u0928\u094d\u092f\u093e\u0938 \u0926\u0940\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908\u0964 \u0907\u0938\u0940 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0905\u092d\u093f\u0937\u0947\u0915 \u0915\u0947 \u0938\u093e\u0925 \u0939\u0940 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0907\u0938 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0909\u092a \u092a\u0940\u0920 \u0915\u0940 2500 \u0935\u0930\u094d\u0937\u094b\u0902 \u0915\u0940 \u0917\u094c\u0930\u0935\u0936\u093e\u0932\u0940 \u0906\u091a\u093e\u0930\u094d\u092f \u092a\u0930\u0902\u092a\u0930\u093e \u0915\u094b \u0906\u0917\u0947 \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u093e \u092e\u0939\u093e\u0928 \u0938\u0902\u0915\u0932\u094d\u092a \u0932\u093f\u092f\u093e\u0964\n                    <\/p>\n            <\/section>\n        <\/main>\n        <!-- Highlights \/ Quick Facts Section -->\n        <section>\n            <h2>\u092e\u0941\u0916\u094d\u092f \u092c\u093f\u0902\u0926\u0941 (Key Highlights)<\/h2>\n                    \ud83d\udd49\ufe0f\n                    <strong>\u092a\u0926 (Position)<\/strong>\n                    <p>71\u0935\u0947\u0902 \u0906\u091a\u093e\u0930\u094d\u092f (71st Aacharya)<\/p>\n                    \ud83d\ude4f\n                    <strong>\u0926\u0940\u0915\u094d\u0937\u093e \u0917\u0941\u0930\u0941 (Initiation By)<\/strong>\n                    <p>70\u0935\u0947\u0902 \u0906\u091a\u093e\u0930\u094d\u092f \u0936\u094d\u0930\u0940 \u0936\u0902\u0915\u0930 \u0935\u093f\u091c\u092f\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u091c\u0940<\/p>\n                    \ud83d\udea9\n                    <strong>\u091c\u0940\u0935\u0928 \u0938\u0902\u0915\u0932\u094d\u092a (Life Resolve)<\/strong>\n                    <p>\u0938\u0928\u093e\u0924\u0928 \u0927\u0930\u094d\u092e \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u094d\u0923\u0924\u0903 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u091c\u0940\u0935\u0928<\/p>\n                    \ud83c\udf3a\n                    <strong>\u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u0940 \u0936\u094d\u0930\u0926\u094d\u0927\u093e (Devotion)<\/strong>\n                    <p>\u0936\u0902\u0915\u0930\u093e\u091a\u093e\u0930\u094d\u092f \u0915\u0947 \u0938\u092e\u0924\u0941\u0932\u094d\u092f \u0906\u0926\u0930 \u0935 \u0935\u0902\u0926\u0928\u093e<\/p>\n        <\/section>\n<\/body>\n<\/html>","post_title":"Sri-Satya-Chandrashekarendra-Saraswathi-Shankaracharya","post_excerpt":"","post_status":"draft","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"sri-satya-chandrashekarendra-saraswathi-shankaracharya","to_ping":"","pinged":"","post_modified":"2026-09-14 11:13:51","post_modified_gmt":"2026-09-14 11:13:51","post_content_filtered":"","post_parent":0,"guid":"https:\/\/shivbodhtrust.org\/?page_id=113","menu_order":0,"post_type":"page","post_mime_type":"","comment_count":"0","url":"https:\/\/shivbodhtrust.org\/?page_id=113"}
