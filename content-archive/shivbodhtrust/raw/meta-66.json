\"><div class=\\\"guru-icon\\\">32<\\\/div><div class=\\\"guru-details\\\"><span class=\\\"guru-name-title\\\"><span class=\\\"en\\\">Nrisimha Bharati VIII<\\\/span><span class=\\\"hi\\\">\\u0928\\u0943\\u0938\\u093f\\u0902\\u0939 \\u092d\\u093e\\u0930\\u0924\\u0940 (\\u0905\\u0937\\u094d\\u091f\\u092e)<\\\/span><\\\/span><\\\/div><\\\/div>\\n                <div class=\\\"guru-row\\\">\\n                    <div class=\\\"guru-icon\\\">33<\\\/div><div class=\\\"guru-details\\\">\\n                        <span class=\\\"guru-name-title\\\"><span class=\\\"en\\\">Satchidananda Shivabhinava Nrisimha Bharati<\\\/span><span class=\\\"hi\\\">\\u0938\\u091a\\u094d\\u091a\\u093f\\u0926\\u093e\\u0928\\u0902\\u0926 \\u0936\\u093f\\u0935\\u093e\\u092d\\u093f\\u0928\\u0935 \\u0928\\u0943\\u0938\\u093f\\u0902\\u0939 \\u092d\\u093e\\u0930\\u0924\\u0940<\\\/span><\\\/span>\\n                        <span class=\\\"guru-period\\\">1872 \\u2013 1912 CE<\\\/span>\\n                        <p class=\\\"guru-desc\\\"><span class=\\\"en\\\">First Acharya of the modern era.<\\\/span><span class=\\\"hi\\\">\\u0906\\u0927\\u0941\\u0928\\u093f\\u0915 \\u092f\\u0941\\u0917 \\u0915\\u0947 \\u092a\\u094d\\u0930\\u0925\\u092e \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f\\u0964<\\\/span><\\\/p>\\n                    <\\\/div>\\n                <\\\/div>\\n\\n                <!-- PART 4 -->\\n                <h3 class=\\\"part-heading\\\"><span class=\\\"en\\\">Part 4: Modern & Current Acharyas (1912 CE to Present)<\\\/span><span class=\\\"hi\\\">\\u092d\\u093e\\u0917 4: \\u0906\\u0927\\u0941\\u0928\\u093f\\u0915 \\u090f\\u0935\\u0902 \\u0935\\u0930\\u094d\\u0924\\u092e\\u093e\\u0928 \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f (1912 \\u0908. \\u0938\\u0947 \\u0905\\u092c \\u0924\\u0915)<\\\/span><\\\/h3>\\n                \\n                <div class=\\\"guru-row\\\">\\n                    <div class=\\\"guru-icon\\\">34<\\\/div><div class=\\\"guru-details\\\">\\n                        <span cla