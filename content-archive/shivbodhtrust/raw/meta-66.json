ada Peetham<\\\/span>\\n                <span class=\\\"hi\\\">\\u0906\\u0926\\u093f \\u0936\\u0902\\u0915\\u0930\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f \\u0938\\u0947 \\u0932\\u0947\\u0915\\u0930 \\u0935\\u0930\\u094d\\u0924\\u092e\\u093e\\u0928 \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f \\u0924\\u0915 \\u0915\\u0940 \\u092a\\u0942\\u0930\\u0940 \\u0938\\u0942\\u091a\\u0940\\u0964 \\u092f\\u0939\\u093e\\u0901 \\u0905\\u092c \\u0924\\u0915 \\u0915\\u0941\\u0932 36 \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f \\u0939\\u094b \\u091a\\u0941\\u0915\\u0947 \\u0939\\u0948\\u0902\\u0964<\\\/span>\\n            <\\\/p>\\n\\n            <div class=\\\"rich-box\\\" style=\\\"padding: 30px; background: #fff; border: 1px solid var(--gold-accent); border-radius: 10px;\\\">\\n                \\n                <!-- PART 1 -->\\n                <h3 class=\\\"part-heading\\\"><span class=\\\"en\\\">Part 1: Early Acharyas (Adi Shankaracharya to Vidyaranya)<\\\/span><span class=\\\"hi\\\">\\u092d\\u093e\\u0917 1: \\u092a\\u094d\\u0930\\u093e\\u0930\\u0902\\u092d\\u093f\\u0915 \\u0906\\u091a\\u093e\\u0930\\u094d\\u092f (\\u0906\\u0926\\u093f \\u0936\\u0902\\u0915\\u0930\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f \\u0938\\u0947 \\u0935\\u093f\\u0926\\u094d\\u092f\\u093e\\u0930\\u0923\\u094d\\u092f \\u0924\\u0915)<\\\/span><\\\/h3>\\n\\n                <div class=\\\"guru-row\\\">\\n                    <div class=\\\"guru-icon\\\">1<\\\/div><div class=\\\"guru-details\\\">\\n                        <span class=\\\"guru-name-title\\\"><span class=\\\"en\\\">Adi Shankaracharya<\\\/span><span class=\\\"hi\\\">\\u0906\\u0926\\u093f \\u0936\\u0902\\u0915\\u0930\\u093e\\u091a\\u093e\\u0930\\u094d\\u092f<\\\/span><\\\/span>\\n                        <span class=\\\"guru-period\\\"><span class=\\\"en\\\">8th Century CE (Approx)<\\\/span><span class=\\\"hi\\\">8\\u0935\\u0940\\u0902 \\u0936\\u0924\\u093e\\u092c\\u094d\\u0926\\u0940 \\u0908. (\\u0932\\u0917\\u092d\\u0917)<\\\/span><\\\/span>\\n  